# AI tutor (local speech does not use this key)
GEMINI_API_KEY=

# Enable only after npm run tts:install and npm run tts:local succeed.
NEXT_PUBLIC_LOCAL_TTS_ENABLED=false

# Optional official Microsoft Neural speech provider (server only)
# Create an Azure Speech resource and use its key and matching region.
# If omitted, the existing Edge TTS connection is used.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Android loads this deployed Next.js server over HTTPS.
LINGUAPULSE_SERVER_URL=
